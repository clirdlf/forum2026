<!-- STATUS NOTICE -->
<section aria-label="Call for proposals status" class="border-b border-outline-variant/35 bg-surface-container-low/55">
    <div class="max-w-5xl mx-auto px-6 py-7">
        <div class="callout callout-info">
            <p class="font-label text-xs font-bold uppercase tracking-widest">Call for Proposals Closed</p>
            <p class="mt-2 text-sm leading-7">
                The Call for Proposals for the 2026 Virtual DLF Forum has now ended. Thank you to everyone who submitted a proposal.
            </p>
        </div>
    </div>
</section>

<!-- HERO -->
<section id="hero">
    <div class="max-w-5xl mx-auto px-6 py-18 lg:py-24">
        <div class="max-w-3xl">
            <p class="eyebrow mb-5">Call for Proposals</p>

            <p class="text-lg text-gray-600">
                Virtual Event | October 14&ndash;15, 2026
            </p>

            <p class="mt-6 text-lg leading-8 text-gray-700">
                CLIR’s Digital Library Federation invites proposals for live virtual sessions.
                Submit your work, ideas, and collaborations to help shape this year’s Forum.
            </p>

            <!-- IMPORTANT NOTE -->
            <div class="mt-8 rounded-3xl border border-yellow-200 bg-yellow-50 px-5 py-4 text-sm leading-7 text-gray-700">
                There will be no in-person event in 2026. This Call for Proposals is for the <strong>October virtual event only</strong>.
            </div>

            <!-- CTA -->
            <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
                {% if metadata.proposal_url %}
                    <a href="{{ metadata.proposal_url }}" class="button-primary">
                        Submit a Proposal
                    </a>
                {% else %}
                    <span class="inline-flex items-center justify-center rounded-full bg-gray-300 px-6 py-3 font-medium text-gray-700">
                        Registration Coming Soon
                    </span>
                {% endif %}
                <a href="#important-dates" class="text-link">Review important dates</a>
            </div>

            <p class="mt-6 text-sm tracking-[0.02em] text-gray-600">
                Submission deadline: <strong>May 11, 2026 at 11:59 pm ET</strong>
            </p>
        </div>
    </div>
</section>

<!-- page nav -->
<section id="page-nav" class="border-y border-outline-variant/35 bg-surface-container-low/55">
    <div class="max-w-6xl mx-auto px-6 py-9">
