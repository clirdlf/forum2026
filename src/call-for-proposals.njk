<!-- HERO -->
<section class="bg-white border-b">
    <div class="max-w-6xl mx-auto px-6 py-16 lg:py-20">
        <div class="max-w-3xl">
            <h1 class="text-4xl font-bold tracking-tight">
                2026 Virtual DLF Forum Call for Proposals
            </h1>

            <p class="mt-4 text-lg text-gray-600">
                Virtual Event | October 14&ndash;15, 2026
            </p>

            <p class="mt-4 text-gray-700">
                CLIR’s Digital Library Federation invites proposals for live virtual sessions.
                Submit your work, ideas, and collaborations to help shape this year’s Forum.
            </p>

            <!-- IMPORTANT NOTE -->
            <div class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-sm">
                There will be no in-person event in 2026. This Call for Proposals is for the <strong>October virtual event only</strong>.
            </div>

            <!-- CTA -->
            <div class="mt-6 flex gap-4">
                {% if metadata.proposal_url %}
                    <a href="{{ metadata.proposal_url }}"
                        class="bg-primary text-on-primary px-8 py-4 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transition-all">
                        Submit a Proposal
                    </a>
                {% else %}
                    <span class="inline-block bg-gray-300 text-gray-700 px-6 py-3 rounded-lg font-medium">
                        Proposal Portal Coming Soon
                    </span>
                {% endif %}
            </div>

            <p class="mt-4 text-sm text-gray-600">
                Submission deadline: <strong>May 11, 2026 at 11:59 pm ET</strong>
            </p>
        </div>
    </div>
</section>

