{%- set navPages = collections.all | eleventyNavigation -%}
{%- set proposalUrl = metadata.proposal_url -%}


<nav id="site-nav" aria-label="Primary" class="fixed top-4 left-1/2 z-50 flex w-[95%] max-w-7xl -translate-x-1/2 flex-col rounded-2xl border border-outline-variant/30 bg-surface/80 px-5 py-3 shadow-[0_8px_32px_rgba(70,119,194,0.06)] backdrop-blur-md md:px-8 md:py-4">
    <div class="flex items-center justify-between gap-4">
        <a href="/" class="flex items-center text-on-primary-fixed-variant" aria-label="{{ metadata.title }}">
            <img
                src="{{ '/static/dlf-forum-2026-logo.svg' }}"
                {# src="{{ '/static/DLF-forum-2026-rgb.svg' }}" #}
                alt="{{ metadata.title }}"
                class="h-10 w-auto md:h-12">
        </a>

        <div class="hidden items-center gap-8 md:flex">
            <div id="pages" class="flex items-center gap-8">
                {% for entry in navPages %}
                    {% set class = 'font-headline tracking-tight font-bold text-lg text-on-surface/70 hover:text-on-primary-fixed-variant transition-colors duration-300' %}
                    {% set isActive = entry.url == page.url or (entry.url != '/' and entry.url in page.url) %}
                    {% set hasChildren = entry.children and entry.children.length %}

                    {% if isActive %}
                        {% set class = class + ' border-b-4 border-primary/40 pb-1 text-on-primary-fixed-variant' %}
                    {% endif %}
                    {% if hasChildren %}
                        <div class="group relative">
                            <a
                                class="{{ class }} inline-flex items-center gap-1"
                                href="{{ entry.url }}"
                                {% if entry.url == page.url %} aria-current="page"{% endif %}
                                aria-haspopup="true">
                                {{ entry.title }}
                                <span class="material-symbols-outlined text-[1.25rem] leading-none transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" aria-hidden="true">expand_more</span>
                            </a>
                            <div class="invisible absolute left-1/2 top-full z-50 min-w-56 -translate-x-1/2 pt-3 opacity-0 transition-opacity duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                                <div class="rounded-xl border border-outline-variant/30 bg-surface px-2 py-2 shadow-[0_16px_40px_rgba(70,119,194,0.16)]">
                                    {% for child in entry.children %}
                                        {% set childClass = 'block rounded-lg px-4 py-3 font-headline text-base font-bold tracking-tight text-on-surface/75 transition-colors duration-200 hover:bg-primary/8 hover:text-on-primary-fixed-variant focus:bg-primary/8 focus:text-on-primary-fixed-variant' %}
                                        {% if child.url == page.url %}
                                            {% set childClass = childClass + ' bg-primary/10 text-on-primary-fixed-variant' %}
                                        {% endif %}
                                        <a class="{{ childClass }}" href="{{ child.url }}"{% if child.url == page.url %} aria-current="page"{% endif %}>{{ child.title }}</a>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <a class="{{ class }}" href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a>
                    {% endif %}
                {% endfor %}
            </div>

            {% if proposalUrl %}
                <a class="text-on-primary-fixed-variant font-semibold transition-opacity hover:opacity-80" href="{{ proposalUrl }}" target="_blank" rel="noopener noreferrer">Submit a Proposal</a>
            {% else %}
                <span class="text-on-primary-fixed-variant/80 font-semibold">Proposal Portal Coming Soon</span>
            {% endif %}
        </div>

        <button
            id="mobile-menu-toggle"
            class="flex h-11 w-11 items-center justify-center rounded-xl border border-outline-variant/60 text-on-primary-fixed-variant transition-colors hover:bg-primary/8 md:hidden"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open site menu">
            <span class="material-symbols-outlined text-[2rem]" aria-hidden="true">menu</span>
        </button>
    </div>

    <div id="mobile-menu" class="hidden border-t border-outline-variant/40 pt-4 mt-4 md:hidden">
        <div class="flex flex-col gap-3">
            {% for entry in navPages %}
                {% set mobileClass = 'font-headline rounded-xl px-3 py-2 text-lg font-bold tracking-tight text-on-surface/80 transition-colors duration-300 hover:bg-primary/8 hover:text-on-primary-fixed-variant' %}
                {% set isActive = entry.url == page.url or (entry.url != '/' and entry.url in page.url) %}
                {% set hasChildren = entry.children and entry.children.length %}

                {% if isActive %}
                    {% set mobileClass = mobileClass + ' bg-primary/10 text-on-primary-fixed-variant' %}
                {% endif %}
                <a class="{{ mobileClass }}" href="{{ entry.url }}" data-nav-link{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a>
                {% if hasChildren %}
                    <div class="-mt-2 ml-4 flex flex-col gap-1 border-l border-outline-variant/50 pl-3">
                        {% for child in entry.children %}
                            {% set childMobileClass = 'font-headline rounded-lg px-3 py-2 text-base font-bold tracking-tight text-on-surface/75 transition-colors duration-300 hover:bg-primary/8 hover:text-on-primary-fixed-variant' %}
                            {% if child.url == page.url %}
                                {% set childMobileClass = childMobileClass + ' bg-primary/10 text-on-primary-fixed-variant' %}
                            {% endif %}
                            <a class="{{ childMobileClass }}" href="{{ child.url }}" data-nav-link{% if child.url == page.url %} aria-current="page"{% endif %}>{{ child.title }}</a>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endfor %}

            {% if proposalUrl %}
                <a class="mt-2 rounded-xl border border-primary/20 px-3 py-3 text-left font-semibold text-on-primary-fixed-variant transition-colors hover:bg-primary/8" href="{{ proposalUrl }}" target="_blank" rel="noopener noreferrer">
                    Submit a Proposal
                </a>
            {% else %}
                <span class="mt-2 rounded-xl border border-primary/20 px-3 py-3 text-left font-semibold text-on-primary-fixed-variant/80">
                    Proposal Portal Coming Soon
                </span>
            {% endif %}
        </div>
    </div>
</nav>

<script>
    (() => {
        const nav = document.getElementById('site-nav');
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        const icon = toggle?.querySelector('.material-symbols-outlined');
        const mobileBreakpoint = window.matchMedia('(min-width: 768px)');
        let lastFocusedElement = null;

        if (!nav || !toggle || !menu || !icon) {
            return;
        }

        const setMenuState = (isOpen) => {
            menu.classList.toggle('hidden', !isOpen);
            toggle.setAttribute('aria-expanded', String(isOpen));
            toggle.setAttribute('aria-label', isOpen ? 'Close site menu' : 'Open site menu');
            icon.textContent = isOpen ? 'close' : 'menu';

            if (isOpen) {
                lastFocusedElement = document.activeElement;
                const firstLink = menu.querySelector('a, button, [tabindex]:not([tabindex="-1"])');
                firstLink?.focus();
                return;
            }

            if (lastFocusedElement === toggle) {
                toggle.focus();
            }
        };

        setMenuState(false);

        toggle.addEventListener('click', () => {
            const isOpen = toggle.getAttribute('aria-expanded') === 'true';
            setMenuState(!isOpen);
        });

        menu.querySelectorAll('[data-nav-link]').forEach((link) => {
            link.addEventListener('click', () => setMenuState(false));
        });

        document.addEventListener('click', (event) => {
            if (toggle.getAttribute('aria-expanded') !== 'true') {
                return;
            }

            if (!nav.contains(event.target)) {
                setMenuState(false);
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                setMenuState(false);
            }
        });

        mobileBreakpoint.addEventListener('change', (event) => {
            if (event.matches) {
                setMenuState(false);
            }
        });
    })();
</script>
