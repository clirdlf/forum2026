---
title: News & Updates
description: Updates and announcements for the 2026 Virtual DLF Forum.
layout: base.njk
eleventyNavigation:
    key: News & Updates
    order: 3
---

{% set posts = collections.post | reverse %}

<section class="px-8 pt-42 pb-24 lg:pt-48 lg:pb-28">
    <div class="mx-auto max-w-7xl editorial-grid items-end">
        <div class="col-span-12 lg:col-span-7">
            <p class="eyebrow">Virtual DLF Forum 2026</p>
            <h1 class="mt-5 font-headline text-[3.65rem] leading-[0.98] tracking-[-0.05em] text-on-surface md:text-[5.75rem]">News &amp; Updates</h1>
            <p class="mt-7 max-w-2xl text-[1.12rem] leading-8 text-on-surface-variant md:text-[1.2rem]">
                Announcements, deadlines, and community updates for the 2026 Virtual DLF Forum.
            </p>
        </div>
        <div class="col-span-12 mt-8 lg:col-span-5 lg:mt-0">
            <div class="callout callout-info">
                <p class="font-label text-xs font-bold uppercase tracking-widest">Forum News</p>
                <p class="mt-2 leading-relaxed">Check here for updates, program announcements, registration details, and practical reminders as the Forum approaches.</p>
            </div>
        </div>
    </div>
</section>

<section class="border-y border-outline-variant/30 bg-surface-container-low">
    <div class="mx-auto max-w-7xl px-8 py-24 lg:py-28">
        {% if posts.length %}
            <div class="mb-10 flex flex-wrap items-center justify-between gap-5">
                <div>
                    <p class="eyebrow">All Posts</p>
                    <h2 class="mt-3 section-title">Latest updates</h2>
                </div>
                <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-2 font-label text-sm font-bold uppercase tracking-[0.14em] text-primary">
                    <span class="material-symbols-outlined text-base" aria-hidden="true">article</span>
                    {{ posts.length }} {% if posts.length == 1 %}post{% else %}posts{% endif %}
                </span>
            </div>

            <div class="grid gap-7 md:grid-cols-2 xl:grid-cols-3">
                {% for post in posts %}
                    <article class="surface-card overflow-hidden">
                        {% if post.data.image %}
                            <a class="block aspect-video overflow-hidden bg-surface-container" href="{{ post.url }}" aria-label="Read {{ post.data.title }}">
                                <img
                                    alt=""
                                    class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                                    loading="lazy"
                                    src="{{ post.data.image }}">
                            </a>
                        {% endif %}
                        <div class="flex h-full flex-col p-8 md:p-9">
                            <div class="mb-6 flex items-center justify-between gap-4">
                                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary-fixed text-primary">
                                    <span class="material-symbols-outlined" aria-hidden="true">campaign</span>
                                </span>
                                <time class="font-mono text-sm font-semibold text-on-surface-variant" datetime="{{ post.date | htmlDateString }}">
                                    {{ post.date | readableDate("LLL d, yyyy") }}
                                </time>
                            </div>
                            <h2 class="font-headline text-[1.9rem] leading-tight tracking-[-0.03em] text-on-surface">
                                <a class="transition-colors hover:text-primary" href="{{ post.url }}">{{ post.data.title }}</a>
                            </h2>
                            <p class="mt-5 flex-1 leading-8 text-on-surface-variant">
                                {{ post.templateContent | firstWords(30) }}
                                <br><a class="mt-10 inline-flex items-center gap-2 font-label text-sm font-bold uppercase tracking-[0.14em] text-primary hover:text-on-primary-fixed-variant" href="{{ post.url }}">
                                Read post
                                <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
                            </a>
                            </p>
                            
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="surface-card max-w-3xl rounded-4xl p-8 md:p-10">
                <h2 class="font-headline text-[2.2rem] leading-tight tracking-[-0.035em] text-on-surface">Posts are coming soon.</h2>
                <p class="mt-5 text-lg leading-8 text-on-surface-variant">
                    This page will collect Forum updates and announcements as they become available.
                </p>
            </div>
        {% endif %}
    </div>
</section>
