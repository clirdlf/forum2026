---
title: Resources
description: "Find DLF Forum 2026 guidance, tools, and reference materials."
layout: base.njk
eleventyExcludeFromCollections: false
eleventyNavigation:
    key: Resources
    order: 3
---

<section class="pt-40 pb-20 px-8">
    <div class="max-w-7xl mx-auto editorial-grid items-end">
        <div class="col-span-12 lg:col-span-8">
            <p class="eyebrow">DLF Forum 2026</p>
            <h1 class="mt-4 font-headline text-5xl md:text-7xl font-extrabold leading-none tracking-tight text-on-surface">Resources</h1>
            <p class="mt-6 max-w-3xl text-xl leading-relaxed text-on-surface-variant">
                Guidance, planning materials, and practical support for presenters, participants, and the wider Forum community.
            </p>
        </div>
        {# <div class="col-span-12 lg:col-span-4">
            <div class="rounded-xl border border-outline-variant/30 bg-surface-container-low px-6 py-5">
                <p class="font-label text-sm font-bold uppercase tracking-wider text-primary">Resource Directory</p>
                <p class="mt-2 text-on-surface-variant">
                    {{ collections.resources.length }} {{ "resource" if collections.resources.length == 1 else "resources" }} available
                </p>
            </div>
        </div> #}
    </div>
</section>

<section class="bg-surface-container-low border-y border-outline-variant/30">
    <div class="max-w-7xl mx-auto px-8 py-20">
        {% if collections.resources.length %}
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                {% for resource in collections.resources %}
                    <a class="surface-card block p-8 transition-transform hover:-translate-y-1" href="{{ resource.url }}">
                        <div class="flex h-full flex-col">
                            <div class="mb-6 flex items-center justify-between gap-4">
                                <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-fixed text-primary">
                                    <span class="material-symbols-outlined" aria-hidden="true">{{ resource.data.icon | default("article") | lower }}</span>
                                </span>
                                {% if resource.data.eleventyNavigation.order %}
                                    <span class="font-mono text-sm font-semibold text-on-surface-variant">0{{ resource.data.eleventyNavigation.order }}</span>
                                {% endif %}
                            </div>
                            <h2 class="font-headline text-2xl font-extrabold text-on-surface">
                                {{ resource.data.title }}
                            </h2>
                            {% if resource.data.description %}
                                <p class="mt-4 flex-1 leading-relaxed text-on-surface-variant">{{ resource.data.description }}</p>
                            {% else %}
                                <p class="mt-4 flex-1 leading-relaxed text-on-surface-variant">Forum guidance and reference material.</p>
                            {% endif %}
                            <span class="mt-8 inline-flex items-center gap-2 font-label font-bold text-primary">
                                Open resource
                                <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
                            </span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="surface-card max-w-3xl p-8 md:p-10">
                <h2 class="font-headline text-3xl font-extrabold text-on-surface">Resources are coming soon.</h2>
                <p class="mt-4 text-lg leading-relaxed text-on-surface-variant">
                    This page will collect Forum guidance and reference materials as they become available.
                </p>
            </div>
        {% endif %}
    </div>
</section>
