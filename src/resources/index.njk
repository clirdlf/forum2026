---
title: Resources
description: "Find DLF Forum 2026 guidance, tools, and reference materials."
layout: base.njk
eleventyExcludeFromCollections: false
eleventyNavigation:
    key: Resources
    order: 4
---

<section class="px-8 pt-42 pb-24 lg:pt-48 lg:pb-28">
    <div class="mx-auto max-w-7xl editorial-grid items-end">
        <div class="col-span-12 lg:col-span-7">
            <p class="eyebrow">Vrtual DLF Forum 2026</p>
            <h1 class="mt-5 font-headline text-[3.65rem] leading-[0.98] tracking-[-0.05em] text-on-surface md:text-[5.75rem]">Resources</h1>
            <p class="mt-7 max-w-2xl text-[1.12rem] leading-8 text-on-surface-variant md:text-[1.2rem]">
                Guidance, planning materials, and practical support for presenters, participants, and the wider Forum community.
            </p>
        </div>
    </div>
</section>

<section class="bg-surface-container-low border-y border-outline-variant/30">
    <div class="max-w-7xl mx-auto px-8 py-24 lg:py-28">
        {% if collections.resources.length %}
            <div class="grid gap-7 md:grid-cols-2 xl:grid-cols-3">
                {% for resource in collections.resources %}
                    <a class="resource-card block p-8 md:p-9" href="{{ resource.url }}">
                        <div class="flex h-full flex-col">
                            <div class="mb-8 flex items-center justify-between gap-4">
                                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary-fixed text-primary">
                                    <span class="material-symbols-outlined" aria-hidden="true">{{ resource.data.icon | default("article") | lower }}</span>
                                </span>
                                {% if resource.data.eleventyNavigation.order %}
                                    <span class="font-mono text-sm font-semibold text-on-surface-variant">0{{ resource.data.eleventyNavigation.order }}</span>
                                {% endif %}
                            </div>
                            <h2 class="font-headline text-[1.9rem] leading-tight tracking-[-0.03em] text-on-surface">
                                {{ resource.data.title }}
                            </h2>
                            {% if resource.data.description %}
                                <p class="mt-5 flex-1 leading-8 text-on-surface-variant">{{ resource.data.description }}</p>
                            {% else %}
                                <p class="mt-5 flex-1 leading-8 text-on-surface-variant">Forum guidance and reference material.</p>
                            {% endif %}
                            <span class="mt-10 inline-flex items-center gap-2 font-label text-sm font-bold uppercase tracking-[0.14em] text-primary">
                                Open resource
                                <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
                            </span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="surface-card max-w-3xl rounded-[2rem] p-8 md:p-10">
                <h2 class="font-headline text-[2.2rem] leading-tight tracking-[-0.035em] text-on-surface">Resources are coming soon.</h2>
                <p class="mt-5 text-lg leading-8 text-on-surface-variant">
                    This page will collect Forum guidance and reference materials as they become available.
                </p>
            </div>
        {% endif %}
    </div>
</section>
