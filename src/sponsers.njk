<section id="sponsors-intro">
    <div class="mx-auto max-w-6xl px-6 py-18 lg:py-24">
        <div class="max-w-3xl">
            <p class="eyebrow">Forum Partners</p>
            <h2 class="mt-4 section-title text-[2.35rem]">Thank you to our sponsors.</h2>
            <p class="mt-6 text-lg leading-8 text-on-surface-variant">
                DLF Forum sponsors support a virtual gathering for digital library, archives, museum, and cultural heritage practitioners. Confirmed sponsors will appear here by sponsorship level.
            </p>
        </div>
    </div>
</section>

<section class="border-y border-outline-variant/35 bg-surface-container-low/55">
    <div class="mx-auto max-w-6xl px-6 py-18 lg:py-24">
        <div class="grid gap-10">
            {% for group in collections.sponsorsByLevel %}
                <section id="{{ group.level | slugify }}" class="sponsor-level-section">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <p class="eyebrow">{{ group.level }}</p>
                            <h2 class="mt-2 font-headline text-[2rem] font-extrabold leading-tight tracking-[-0.035em] text-on-surface">{{ group.level }} Sponsors</h2>
                        </div>
                        <span class="inline-flex w-fit rounded-full bg-surface-container-lowest px-4 py-2 font-label text-sm font-bold text-on-surface-variant shadow-card">
                            {{ group.sponsors.length }} sponsor{% if group.sponsors.length != 1 %}s{% endif %}
                        </span>
                    </div>

                    {% if group.sponsors.length %}
                        <div class="mt-6 grid gap-6 md:grid-cols-2">
                            {% for sponsor in group.sponsors %}
                                <article class="sponsor-card surface-card rounded-[1.6rem] p-6 md:p-7">
                                    <div class="flex h-full flex-col">
                                        <a class="sponsor-logo-frame" href="{{ sponsor.url }}" target="_blank" rel="noopener noreferrer" aria-label="Visit {{ sponsor.name }}">
                                            <img src="{{ sponsor.logo }}" alt="{{ sponsor.name }} logo" loading="lazy" decoding="async">
                                        </a>

                                        <div class="mt-6 flex flex-wrap items-start justify-between gap-3">
                                            <h3 class="font-headline text-[1.55rem] font-extrabold leading-tight tracking-[-0.03em] text-on-surface">
                                                <a class="text-on-surface transition-colors hover:text-primary" href="{{ sponsor.url }}" target="_blank" rel="noopener noreferrer">{{ sponsor.name }}</a>
                                            </h3>
                                            {% if sponsor.placeholder %}
                                                <span class="rounded-full bg-accent-soft px-3 py-1 font-label text-xs font-bold uppercase tracking-wider text-accent">Placeholder</span>
                                            {% endif %}
                                        </div>

                                        <p class="mt-4 flex-1 text-sm leading-7 text-on-surface-variant">{{ sponsor.description }}</p>

                                        <a class="mt-6 inline-flex items-center gap-2 font-label text-sm font-bold uppercase tracking-[0.14em] text-primary" href="{{ sponsor.url }}" target="_blank" rel="noopener noreferrer">
                                            Visit sponsor
                                            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_outward</span>
                                        </a>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="mt-6 surface-card rounded-[1.6rem] p-7 md:p-8">
                            <p class="text-lg leading-8 text-on-surface-variant">Become a <a href="/sponsorship/#{{ group.level | lower }}-sponsorship" class="text-primary underline"> {{ group.level | lower }} sponsor!</a></p>
                        </div>
                    {% endif %}
                </section>
            {% endfor %}
        </div>
    </div>
</section>
