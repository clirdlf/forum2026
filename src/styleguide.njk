---
title: Styleguide
layout: base.njk
description: Current style and component reference for the DLF Forum 2026 site.
permalink: /styleguide/
eleventyExcludeFromCollections: true
---

{% set colorTokens = [
    { name: 'Primary', token: '--color-primary', use: 'Primary actions, active navigation, editorial emphasis' },
    { name: 'Primary Container', token: '--color-primary-container', use: 'Large blue feature areas and gradients' },
    { name: 'Accent', token: '--color-accent', use: 'Small highlights, icons, and warm emphasis' },
    { name: 'Surface', token: '--color-surface', use: 'Page background and navigation glass' },
    { name: 'Surface Low', token: '--color-surface-container-low', use: 'Section bands and quiet contrast' },
    { name: 'Surface Highest', token: '--color-surface-container-highest', use: 'Dense cards and elevated content' },
    { name: 'Outline Variant', token: '--color-outline-variant', use: 'Soft borders, dividers, and timelines' },
    { name: 'Info', token: '--color-info', use: 'Informational callouts and support states' },
    { name: 'Success', token: '--color-success', use: 'Confirmed and completed states' },
    { name: 'Error', token: '--color-error', use: 'Errors and destructive warnings' }
] %}

{% set typeScale = [
    { label: 'Hero', class: 'font-headline text-5xl md:text-7xl font-extrabold leading-none tracking-tight', text: 'Welcome to the DLF Virtual Forum' },
    { label: 'Section', class: 'section-title', text: 'Reusable page rhythm' },
    { label: 'Card Heading', class: 'font-headline text-2xl font-extrabold leading-tight', text: 'A broad practitioner mix' },
    { label: 'Body', class: 'text-lg leading-relaxed text-on-surface-variant', text: 'Forum pages use generous line height, clear hierarchy, and warm surface contrast for long-form guidance.' },
    { label: 'Label', class: 'eyebrow', text: 'DLF Forum 2026' },
    { label: 'Mono', class: 'font-mono text-sm font-semibold text-on-surface-variant', text: 'Phase 01 / Oct 14-15' }
] %}

{% set timeline = [
    { phase: 'Phase 01', title: 'Submissions Open', date: 'April 14, 2026', active: true },
    { phase: 'Phase 02', title: 'CFP Deadline', date: 'May 11, 2026', active: false },
    { phase: 'Phase 03', title: 'Forum Dates', date: 'October 14-15, 2026', active: false }
] %}

<div class="styleguide-shell">
    <section class="relative overflow-hidden px-8 pt-40 pb-24">
        <div class="mx-auto max-w-7xl editorial-grid items-center">
            <div class="col-span-12 z-10 lg:col-span-7">
                <p class="eyebrow">Design Reference</p>
                <h1 class="mt-4 font-headline text-5xl font-extrabold leading-none tracking-tight text-on-surface md:text-7xl">
                    Current style and flow.
                </h1>
                <p class="mt-6 max-w-2xl text-xl leading-relaxed text-on-surface-variant">
                    The site uses editorial spacing, warm paper surfaces, rounded content blocks, direct calls to action, and compact utility patterns for navigation, resources, and event details.
                </p>
                <div class="mt-10 flex flex-wrap gap-4">
                    <a href="#components" class="button-primary">View components</a>
                    <a href="#flow" class="button-secondary">Review page flow</a>
                </div>
            </div>

            <div class="col-span-12 mt-12 lg:col-span-5 lg:mt-0">
                <div class="relative overflow-hidden rounded-4xl bg-primary text-on-primary shadow-2xl">
                    <div class="absolute inset-0 bg-linear-to-br from-primary via-primary-container/90 to-info/80"></div>
                    <div class="relative p-10 md:p-12">
                        <p class="font-label text-xs font-bold uppercase tracking-widest text-on-primary/90">System Snapshot</p>
                        <h2 class="mt-3 font-headline text-3xl font-bold leading-tight">
                            Build pages as clear editorial sections with focused action moments.
                        </h2>
                        <div class="mt-8 space-y-4">
                            <div class="rounded-3xl border border-on-primary/15 bg-on-primary/12 p-5 backdrop-blur-sm">
                                <p class="font-headline text-xl font-bold">Hero</p>
                                <p class="mt-1 text-on-primary">Set context quickly, then offer the next step.</p>
                            </div>
                            <div class="rounded-3xl border border-on-primary/15 bg-on-primary/12 p-5 backdrop-blur-sm">
                                <p class="font-headline text-xl font-bold">Content Bands</p>
                                <p class="mt-1 text-on-primary">Alternate open sections and soft surface backgrounds.</p>
                            </div>
                            <div class="rounded-3xl border border-on-primary/15 bg-on-primary/12 p-5 backdrop-blur-sm">
                                <p class="font-headline text-xl font-bold">Cards</p>
                                <p class="mt-1 text-on-primary">Use cards for repeated objects, feature summaries, and resource links.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="flow" class="border-y border-outline-variant/30 bg-surface-container-low">
        <div class="mx-auto max-w-7xl px-8 py-20">
            <div class="max-w-3xl">
                <p class="eyebrow">Page Flow</p>
                <h2 class="mt-3 section-title">The current rhythm</h2>
                <p class="mt-5 text-lg leading-relaxed text-on-surface-variant">
                    Start with a concise hero, move into a high-context feature block, use cards for scannable choices, and close with a direct action or next step.
                </p>
            </div>

            <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
                <article class="surface-card p-8">
                    <span class="font-mono text-sm font-semibold text-on-surface-variant">01</span>
                    <h3 class="mt-4 font-headline text-2xl font-extrabold text-on-surface">Hero</h3>
                    <p class="mt-3 leading-relaxed text-on-surface-variant">Large headline, short supporting copy, and one or two clear paths forward.</p>
                </article>
                <article class="surface-card p-8">
                    <span class="font-mono text-sm font-semibold text-on-surface-variant">02</span>
                    <h3 class="mt-4 font-headline text-2xl font-extrabold text-on-surface">Context</h3>
                    <p class="mt-3 leading-relaxed text-on-surface-variant">Use a broad feature card or split editorial block to explain the page purpose.</p>
                </article>
                <article class="surface-card p-8">
                    <span class="font-mono text-sm font-semibold text-on-surface-variant">03</span>
                    <h3 class="mt-4 font-headline text-2xl font-extrabold text-on-surface">Choices</h3>
                    <p class="mt-3 leading-relaxed text-on-surface-variant">Cards, badges, page anchors, and timelines make longer pages easier to scan.</p>
                </article>
                <article class="surface-card p-8">
                    <span class="font-mono text-sm font-semibold text-on-surface-variant">04</span>
                    <h3 class="mt-4 font-headline text-2xl font-extrabold text-on-surface">Action</h3>
                    <p class="mt-3 leading-relaxed text-on-surface-variant">Close sections with direct buttons or resource links instead of broad promotional copy.</p>
                </article>
            </div>
        </div>
    </section>

    <section id="tokens" class="px-8 py-20">
        <div class="mx-auto max-w-7xl">
            <div class="max-w-3xl">
                <p class="eyebrow">Tokens</p>
                <h2 class="mt-3 section-title">Color and type</h2>
                <p class="mt-5 text-lg leading-relaxed text-on-surface-variant">
                    Tokens come from the Tailwind theme in <code class="font-mono text-sm">site.css</code>. Prefer these utilities over one-off colors.
                </p>
            </div>

            <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
                {% for swatch in colorTokens %}
                    <article class="overflow-hidden rounded-3xl border border-outline-variant/30 bg-surface-container-lowest shadow-(--shadow-card)">
                        <div class="h-28" style="background: var({{ swatch.token }});"></div>
                        <div class="p-5">
                            <h3 class="font-headline text-xl font-extrabold text-on-surface">{{ swatch.name }}</h3>
                            <p class="mt-2 font-mono text-xs font-semibold text-on-surface-variant">{{ swatch.token }}</p>
                            <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">{{ swatch.use }}</p>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="mt-12 space-y-5">
                {% for type in typeScale %}
                    <article class="surface-card p-6 md:p-8">
                        <div class="grid gap-5 md:grid-cols-[12rem_minmax(0,1fr)] md:items-center">
                            <div>
                                <p class="font-label text-xs font-bold uppercase tracking-widest text-primary">{{ type.label }}</p>
                                <p class="mt-2 font-mono text-xs text-on-surface-variant">{{ type.class }}</p>
                            </div>
                            <p class="{{ type.class }}">{{ type.text }}</p>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="components" class="border-y border-outline-variant/30 bg-surface-container-low">
        <div class="mx-auto max-w-7xl px-8 py-20">
            <div class="max-w-3xl">
                <p class="eyebrow">Components</p>
                <h2 class="mt-3 section-title">Current reusable patterns</h2>
                <p class="mt-5 text-lg leading-relaxed text-on-surface-variant">
                    These examples match the active site language: pill buttons, high-contrast feature panels, soft cards, resource links, form fields, and event timelines.
                </p>
            </div>

            <div class="mt-10 showcase-grid">
                <article class="surface-card p-8">
                    <p class="eyebrow">Actions</p>
                    <h3 class="mt-3 font-headline text-3xl font-extrabold text-on-surface">Buttons and inline links</h3>
                    <div class="mt-6 flex flex-wrap gap-4">
                        <a href="#0" class="button-primary">Register for the Forum</a>
                        <a href="#0" class="button-secondary">Explore the program</a>
                        <a href="#0" class="button-ghost">
                            Read the Code of Conduct
                            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_outward</span>
                        </a>
                    </div>
                    <p class="mt-6 text-lg leading-relaxed text-on-surface-variant">
                        Use <a href="#0" class="text-link">inline links</a> when the action belongs inside editorial copy.
                    </p>
                </article>

                <article class="surface-card p-8">
                    <p class="eyebrow">Badges</p>
                    <h3 class="mt-3 font-headline text-3xl font-extrabold text-on-surface">Compact facts</h3>
                    <div class="mt-6 flex flex-wrap gap-3">
                        <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-2 text-sm font-bold text-primary">
                            <span class="material-symbols-outlined text-base" aria-hidden="true">diversity_3</span>
                            Libraries, archives, and museums
                        </span>
                        <span class="inline-flex items-center gap-2 rounded-full bg-secondary-fixed px-4 py-2 text-sm font-bold text-on-secondary-fixed">
                            <span class="material-symbols-outlined text-base" aria-hidden="true">public</span>
                            Virtual event
                        </span>
                        <span class="inline-flex items-center gap-2 rounded-full bg-tertiary-fixed px-4 py-2 text-sm font-bold text-on-tertiary-fixed">
                            <span class="material-symbols-outlined text-base" aria-hidden="true">build</span>
                            Practical sessions
                        </span>
                    </div>
                </article>

                <article class="surface-card p-8">
                    <p class="eyebrow">Resource Card</p>
                    <a class="mt-3 block rounded-3xl border border-outline-variant/30 bg-surface-container-lowest p-6 transition-transform hover:-translate-y-1" href="#0">
                        <div class="mb-6 flex items-center justify-between gap-4">
                            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-fixed text-primary">
                                <span class="material-symbols-outlined" aria-hidden="true">article</span>
                            </span>
                            <span class="font-mono text-sm font-semibold text-on-surface-variant">01</span>
                        </div>
                        <h3 class="font-headline text-2xl font-extrabold text-on-surface">For presenters</h3>
                        <p class="mt-4 leading-relaxed text-on-surface-variant">Guidance and practical support for Forum contributors.</p>
                        <span class="mt-8 inline-flex items-center gap-2 font-label font-bold text-primary">
                            Open resource
                            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
                        </span>
                    </a>
                </article>

                <article class="surface-card p-8">
                    <p class="eyebrow">Forms</p>
                    <h3 class="mt-3 font-headline text-3xl font-extrabold text-on-surface">Inputs</h3>
                    <div class="mt-6 space-y-5">
                        <div>
                            <label class="form-label" for="sg-name">Full name</label>
                            <input id="sg-name" class="form-field" type="text" placeholder="Jordan Lee">
                        </div>
                        <div>
                            <label class="form-label" for="sg-topic">Session topic</label>
                            <select id="sg-topic" class="form-field">
                                <option>Choose a track</option>
                                <option>Collections and Stewardship</option>
                                <option>Community and Advocacy</option>
                                <option>Infrastructure</option>
                            </select>
                        </div>
                    </div>
                </article>

                <article class="surface-card p-8">
                    <p class="eyebrow">Callouts</p>
                    <h3 class="mt-3 font-headline text-3xl font-extrabold text-on-surface">Status messaging</h3>
                    <div class="mt-6 space-y-4">
                        <div class="callout callout-info">
                            <p class="font-label text-xs font-bold uppercase tracking-widest">Informational</p>
                            <p class="mt-2 leading-relaxed">Use for registration updates, deadline notes, and guidance that should stay visible.</p>
                        </div>
                        <div class="callout callout-success">
                            <p class="font-label text-xs font-bold uppercase tracking-widest">Success</p>
                            <p class="mt-2 leading-relaxed">Use for confirmed submissions, completed forms, and post-action messages.</p>
                        </div>
                    </div>
                </article>

                <article class="surface-card p-8">
                    <p class="eyebrow">Timeline</p>
                    <h3 class="mt-3 font-headline text-3xl font-extrabold text-on-surface">Important dates</h3>
                    <div class="mt-8">
                        {% for item in timeline %}
                            <div class="relative border-l-2 border-outline-variant pb-10 pl-8 last:border-l-0 last:pb-0">
                                <div class="absolute -left-2.25 top-0 h-4 w-4 rounded-full ring-4 ring-surface-container-lowest {% if item.active %}bg-primary{% else %}bg-secondary-container{% endif %}"></div>
                                <span class="font-headline text-xs font-bold uppercase tracking-wider {% if item.active %}text-primary{% else %}text-secondary{% endif %}">{{ item.phase }}</span>
                                <h4 class="mt-1 font-headline text-xl font-bold text-on-surface">{{ item.title }}</h4>
                                <p class="mt-2 text-on-surface-variant">{{ item.date }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </article>
            </div>
        </div>
    </section>
</div>
